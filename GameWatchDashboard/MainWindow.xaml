<Window x:Class="GameWatchDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameWatch"
        Height="760"
        Width="1280"
        MinHeight="700"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0D0F12">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================================================== -->
        <!-- SIDEBAR -->
        <!-- ===================================================== -->

        <Border Grid.Column="0"
                Background="#111419"
                BorderBrush="#232833"
                BorderThickness="0,0,1,0">

            <Grid Margin="18">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="4,12,0,0">

                    <TextBlock Text="GAMEWATCH"
                               Foreground="#7CFF6B"
                               FontSize="26"
                               FontWeight="Bold"/>

                    <TextBlock Text="Game activity tracker"
                               Foreground="#7C8597"
                               FontSize="12"
                               Margin="1,4,0,0"/>

                </StackPanel>

                <StackPanel Grid.Row="2">

                    <Button x:Name="DashboardButton"
                            Content="Dashboard"
                            Height="46"
                            Margin="0,0,0,8"
                            Background="#1D2621"
                            Foreground="#7CFF6B"
                            BorderBrush="#2F3B32"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Padding="14,0"/>

                    <Button x:Name="LibraryButton"
                            Content="Library"
                            Height="46"
                            Margin="0,0,0,8"
                            Background="#15191F"
                            Foreground="#D3D7DE"
                            BorderBrush="#252A31"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Padding="14,0"/>

                    <Button x:Name="SessionsButton"
                            Content="Sessions"
                            Height="46"
                            Margin="0,0,0,8"
                            Background="#15191F"
                            Foreground="#D3D7DE"
                            BorderBrush="#252A31"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Padding="14,0"/>

                    <Button x:Name="StatisticsButton"
                            Content="Statistics"
                            Height="46"
                            Margin="0,0,0,8"
                            Background="#15191F"
                            Foreground="#D3D7DE"
                            BorderBrush="#252A31"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Padding="14,0"/>

                    <Button x:Name="CalendarButton"
                            Content="Calendar"
                            Height="46"
                            Margin="0,0,0,8"
                            Background="#15191F"
                            Foreground="#D3D7DE"
                            BorderBrush="#252A31"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Padding="14,0"/>

                    <Button x:Name="AchievementsButton"
                            Content="Achievements"
                            Height="46"
                            Margin="0,0,0,8"
                            Background="#15191F"
                            Foreground="#D3D7DE"
                            BorderBrush="#252A31"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Padding="14,0"/>

                    <Button x:Name="SettingsButton"
                            Content="Settings"
                            Height="46"
                            Margin="0,0,0,8"
                            Background="#15191F"
                            Foreground="#D3D7DE"
                            BorderBrush="#252A31"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Padding="14,0"/>

                </StackPanel>

                <Border Grid.Row="3"
                        Background="#15191F"
                        BorderBrush="#252A31"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12">

                    <StackPanel>

                        <TextBlock Text="SERVICE STATUS"
                                   Foreground="#7C8597"
                                   FontSize="11"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,7,0,0">

                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="#7CFF6B"
                                     Margin="0,4,8,0"/>

                            <TextBlock Text="Running"
                                       Foreground="#E7EAF0"
                                       FontWeight="SemiBold"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- ===================================================== -->
        <!-- PAGE AREA -->
        <!-- ===================================================== -->

        <Grid Grid.Column="1">

            <!-- ================================================= -->
            <!-- DASHBOARD -->
            <!-- ================================================= -->

            <ScrollViewer x:Name="DashboardPage"
                          Visibility="Visible"
                          VerticalScrollBarVisibility="Auto">

                <Grid Margin="30">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Dashboard"
                                       Foreground="White"
                                       FontSize="30"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Track your gaming activity and recent sessions."
                                       Foreground="#8B94A5"
                                       FontSize="14"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#15191F"
                                BorderBrush="#252A31"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,9"
                                VerticalAlignment="Center">

                            <TextBlock Text="GameWatch Online"
                                       Foreground="#7CFF6B"
                                       FontWeight="SemiBold"/>

                        </Border>

                    </Grid>

                    <!-- NOW PLAYING -->

                    <Border Grid.Row="2"
                            Background="#15191F"
                            BorderBrush="#252A31"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="22">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="NOW PLAYING"
                                           Foreground="#7C8597"
                                           FontSize="11"/>

                                <TextBlock x:Name="NowPlayingGameText"
                                           Text="No game detected"
                                           Foreground="White"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>

                                <TextBlock x:Name="NowPlayingSubtitleText"
                                           Text="Start a game and GameWatch will detect it automatically."
                                           Foreground="#8B94A5"
                                           FontSize="13"
                                           Margin="0,5,0,0"/>

                            </StackPanel>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="SESSION TIME"
                                           Foreground="#7C8597"
                                           FontSize="11"
                                           HorizontalAlignment="Right"/>

                                <TextBlock x:Name="SessionTimerText"
                                           Text="00:00:00"
                                           Foreground="#7CFF6B"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Margin="0,7,0,0"
                                           HorizontalAlignment="Right"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <!-- PLAYTIME -->

                    <Grid Grid.Row="4">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#15191F"
                                BorderBrush="#252A31"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">

                            <StackPanel>

                                <TextBlock Text="TODAY"
                                           Foreground="#7C8597"
                                           FontSize="11"/>

                                <TextBlock x:Name="TodayPlaytimeText"
                                           Text="0h 00m"
                                           Foreground="White"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="2"
                                Background="#15191F"
                                BorderBrush="#252A31"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">

                            <StackPanel>

                                <TextBlock Text="THIS WEEK"
                                           Foreground="#7C8597"
                                           FontSize="11"/>

                                <TextBlock x:Name="WeekPlaytimeText"
                                           Text="0h 00m"
                                           Foreground="White"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="4"
                                Background="#15191F"
                                BorderBrush="#252A31"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">

                            <StackPanel>

                                <TextBlock Text="THIS MONTH"
                                           Foreground="#7C8597"
                                           FontSize="11"/>

                                <TextBlock x:Name="MonthPlaytimeText"
                                           Text="0h 00m"
                                           Foreground="White"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="6"
                                Background="#15191F"
                                BorderBrush="#252A31"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">

                            <StackPanel>

                                <TextBlock Text="ALL TIME"
                                           Foreground="#7C8597"
                                           FontSize="11"/>

                                <TextBlock x:Name="AllTimePlaytimeText"
                                           Text="0h 00m"
                                           Foreground="White"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- LOWER DASHBOARD -->

                    <Grid Grid.Row="6">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#15191F"
                                BorderBrush="#252A31"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Recent Sessions"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <Separator Margin="0,14"
                                           Background="#252A31"/>

                                <StackPanel x:Name="RecentSessionsPanel"/>

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="2"
                                Background="#15191F"
                                BorderBrush="#252A31"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Top Games"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <Separator Margin="0,14"
                                           Background="#252A31"/>

                                <StackPanel x:Name="TopGamesPanel"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Grid>

            </ScrollViewer>

            <!-- ================================================= -->
            <!-- LIBRARY -->
            <!-- ================================================= -->

            <ScrollViewer x:Name="LibraryPage"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="30">

                    <TextBlock Text="Library"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>

                    <TextBlock Text="Games recorded by GameWatch."
                               Foreground="#8B94A5"
                               FontSize="14"
                               Margin="0,5,0,24"/>

                    <Grid Margin="0,0,0,24">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#15191F"
                                BorderBrush="#252A31"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">

                            <StackPanel>
                                <TextBlock Text="GAMES PLAYED"
                                           Foreground="#7C8597"/>
                                <TextBlock x:Name="LibraryGameCountText"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>
                            </StackPanel>

                        </Border>

                        <Border Grid.Column="2"
                                Background="#15191F"
                                BorderBrush="#252A31"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">

                            <StackPanel>
                                <TextBlock Text="TOTAL SESSIONS"
                                           Foreground="#7C8597"/>
                                <TextBlock x:Name="LibrarySessionCountText"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>
                            </StackPanel>

                        </Border>

                        <Border Grid.Column="4"
                                Background="#15191F"
                                BorderBrush="#252A31"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">

                            <StackPanel>
                                <TextBlock Text="TOTAL PLAYTIME"
                                           Foreground="#7C8597"/>
                                <TextBlock x:Name="LibraryPlaytimeText"
                                           Text="0h 00m"
                                           Foreground="#7CFF6B"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>
                            </StackPanel>

                        </Border>

                    </Grid>

                    <Border Background="#15191F"
                            BorderBrush="#252A31"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="Game Library"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <Separator Margin="0,14"
                                       Background="#252A31"/>

                            <StackPanel x:Name="LibraryGamesPanel"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <!-- ================================================= -->
            <!-- SESSIONS -->
            <!-- ================================================= -->

            <ScrollViewer x:Name="SessionsPage"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="30">

                    <TextBlock Text="Sessions"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>

                    <TextBlock Text="Complete history of your recorded gaming sessions."
                               Foreground="#8B94A5"
                               FontSize="14"
                               Margin="0,5,0,24"/>

                    <Border Background="#15191F"
                            BorderBrush="#252A31"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="20">

                        <StackPanel>

                            <Grid Margin="0,0,0,14">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Session History"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="SessionsTotalText"
                                           Grid.Column="1"
                                           Text="0 sessions"
                                           Foreground="#7CFF6B"
                                           VerticalAlignment="Center"/>

                            </Grid>

                            <Separator Background="#252A31"/>

                            <StackPanel x:Name="AllSessionsPanel"
                                        Margin="0,14,0,0"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <!-- ================================================= -->
            <!-- STATISTICS -->
            <!-- ================================================= -->

            <ScrollViewer x:Name="StatisticsPage"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="30">

                    <TextBlock Text="Statistics"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>

                    <TextBlock Text="A deeper look at your GameWatch activity."
                               Foreground="#8B94A5"
                               FontSize="14"
                               Margin="0,5,0,24"/>

                    <!-- TOP SUMMARY CARDS -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#15191F" BorderBrush="#252A31" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="TOTAL PLAYTIME" Foreground="#7C8597" FontSize="11"/>
                                <TextBlock x:Name="StatsTotalPlaytimeText" Text="0h 00m" Foreground="#7CFF6B" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#15191F" BorderBrush="#252A31" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="TOTAL SESSIONS" Foreground="#7C8597" FontSize="11"/>
                                <TextBlock x:Name="StatsSessionCountText" Text="0" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#15191F" BorderBrush="#252A31" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="AVERAGE SESSION" Foreground="#7C8597" FontSize="11"/>
                                <TextBlock x:Name="StatsAverageSessionText" Text="0h 00m" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Background="#15191F" BorderBrush="#252A31" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="GAMES PLAYED" Foreground="#7C8597" FontSize="11"/>
                                <TextBlock x:Name="StatsGamesPlayedText" Text="0" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- SECOND SUMMARY ROW -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#15191F" BorderBrush="#252A31" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="MOST PLAYED GAME" Foreground="#7C8597" FontSize="11"/>
                                <TextBlock x:Name="StatsMostPlayedGameText" Text="No data yet" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="StatsMostPlayedDurationText" Text="0h 00m" Foreground="#7CFF6B" FontSize="13" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#15191F" BorderBrush="#252A31" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="LONGEST SESSION" Foreground="#7C8597" FontSize="11"/>
                                <TextBlock x:Name="StatsLongestSessionText" Text="0h 00m" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                                <TextBlock x:Name="StatsLongestSessionGameText" Text="No data yet" Foreground="#8B94A5" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#15191F" BorderBrush="#252A31" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="MOST USED LAUNCHER" Foreground="#7C8597" FontSize="11"/>
                                <TextBlock x:Name="StatsMostUsedLauncherText" Text="No data yet" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/>
                                <TextBlock x:Name="StatsMostUsedLauncherDurationText" Text="0h 00m" Foreground="#7CFF6B" FontSize="13" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Background="#15191F" BorderBrush="#252A31" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="AVG PLAYTIME / DAY" Foreground="#7C8597" FontSize="11"/>
                                <TextBlock x:Name="StatsAverageDailyText" Text="0h 00m" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                                <TextBlock Text="Across tracked calendar days" Foreground="#8B94A5" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- PLAYTIME BREAKDOWNS -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#15191F" BorderBrush="#252A31" BorderThickness="1" CornerRadius="14" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Playtime by Game" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Your games ranked by total tracked playtime." Foreground="#8B94A5" FontSize="12" Margin="0,4,0,0"/>
                                <Separator Margin="0,14" Background="#252A31"/>
                                <StackPanel x:Name="StatsPlaytimeByGamePanel"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#15191F" BorderBrush="#252A31" BorderThickness="1" CornerRadius="14" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Playtime by Launcher" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="See where your tracked gaming time comes from." Foreground="#8B94A5" FontSize="12" Margin="0,4,0,0"/>
                                <Separator Margin="0,14" Background="#252A31"/>
                                <StackPanel x:Name="StatsPlaytimeByLauncherPanel"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- LAST 7 DAYS -->
                    <Border Background="#15191F"
                            BorderBrush="#252A31"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="20"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Last 7 Days Activity" Foreground="White" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Daily tracked playtime, including days with no gaming." Foreground="#8B94A5" FontSize="12" Margin="0,4,0,0"/>
                            <Separator Margin="0,14" Background="#252A31"/>
                            <StackPanel x:Name="StatsLast7DaysPanel"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </ScrollViewer>

            <!-- ================================================= -->
            <!-- CALENDAR -->
            <!-- ================================================= -->

            <ScrollViewer x:Name="CalendarPage"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="30">

                    <TextBlock Text="Calendar"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>

                    <TextBlock Text="Your gaming activity grouped by day."
                               Foreground="#8B94A5"
                               FontSize="14"
                               Margin="0,5,0,24"/>

                    <Border Background="#15191F"
                            BorderBrush="#252A31"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="Activity History"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <Separator Margin="0,14"
                                       Background="#252A31"/>

                            <StackPanel x:Name="CalendarActivityPanel"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <!-- ================================================= -->
            <!-- ACHIEVEMENTS -->
            <!-- ================================================= -->

            <ScrollViewer x:Name="AchievementsPage"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="30">

                    <TextBlock Text="Achievements"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>

                    <TextBlock Text="Milestones earned from your GameWatch activity."
                               Foreground="#8B94A5"
                               FontSize="14"
                               Margin="0,5,0,24"/>

                    <Border Background="#15191F"
                            BorderBrush="#252A31"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="20">

                        <StackPanel x:Name="AchievementsPanel"/>

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <!-- ================================================= -->
            <!-- SETTINGS -->
            <!-- ================================================= -->

            <ScrollViewer x:Name="SettingsPage"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="30">

                    <TextBlock Text="Settings"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>

                    <TextBlock Text="Configure how GameWatch behaves on your computer."
                               Foreground="#8B94A5"
                               FontSize="14"
                               Margin="0,5,0,24"/>

                    <!-- GENERAL -->
                    <Border Background="#15191F"
                            BorderBrush="#252A31"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="20"
                            Margin="0,0,0,18">

                        <StackPanel>

                            <TextBlock Text="General"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Launch dashboard at Windows startup"
                                               Foreground="#E7EAF0"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="Automatically open the GameWatch dashboard when you sign in to Windows."
                                               Foreground="#8B94A5"
                                               FontSize="12"
                                               Margin="0,4,20,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <CheckBox x:Name="SettingsLaunchAtStartupCheckBox"
                                          Grid.Column="1"
                                          Content="Enabled"
                                          Foreground="#7CFF6B"
                                          VerticalAlignment="Center"
                                          Margin="20,0,0,0"/>
                            </Grid>

                            <Border Height="1"
                                    Background="#252A31"
                                    Margin="0,18"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Minimize to system tray"
                                               Foreground="#E7EAF0"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="When you click X, keep GameWatch running from the notification area instead of exiting."
                                               Foreground="#8B94A5"
                                               FontSize="12"
                                               Margin="0,4,20,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <CheckBox x:Name="SettingsMinimizeToTrayCheckBox"
                                          Grid.Column="1"
                                          Content="Enabled"
                                          Foreground="#7CFF6B"
                                          VerticalAlignment="Center"
                                          Margin="20,0,0,0"/>
                            </Grid>

                            <Border Height="1"
                                    Background="#252A31"
                                    Margin="0,18"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Desktop notifications"
                                               Foreground="#E7EAF0"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="Allow GameWatch to show notifications for game activity."
                                               Foreground="#8B94A5"
                                               FontSize="12"
                                               Margin="0,4,20,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <CheckBox x:Name="SettingsNotificationsCheckBox"
                                          Grid.Column="1"
                                          Content="Enabled"
                                          Foreground="#7CFF6B"
                                          VerticalAlignment="Center"
                                          Margin="20,0,0,0"/>
                            </Grid>

                        </StackPanel>

                    </Border>

                    <!-- UPDATES -->
                    <Border Background="#15191F"
                            BorderBrush="#252A31"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="20"
                            Margin="0,0,0,18">

                        <StackPanel>

                            <TextBlock Text="Updates"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Text="GameWatch checks your GitHub releases so you can install new versions without visiting the website."
                                       Foreground="#8B94A5"
                                       FontSize="12"
                                       Margin="0,5,0,18"
                                       TextWrapping="Wrap"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CURRENT VERSION"
                                               Foreground="#7C8597"
                                               FontSize="11"/>
                                    <TextBlock x:Name="SettingsCurrentVersionText"
                                               Text="1.0.0"
                                               Foreground="White"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="LATEST VERSION"
                                               Foreground="#7C8597"
                                               FontSize="11"/>
                                    <TextBlock x:Name="SettingsLatestVersionText"
                                               Text="Not checked yet"
                                               Foreground="#7CFF6B"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,18,0,0">

                                <Button x:Name="SettingsCheckForUpdatesButton"
                                        Content="Check for Updates"
                                        MinWidth="160"
                                        Height="38"
                                        Padding="16,0"
                                        Background="#1D2621"
                                        Foreground="#7CFF6B"
                                        BorderBrush="#2F3B32"/>

                                <Button x:Name="SettingsInstallUpdateButton"
                                        Content="Download &amp; Install Update"
                                        MinWidth="210"
                                        Height="38"
                                        Padding="16,0"
                                        Margin="12,0,0,0"
                                        Background="#7CFF6B"
                                        Foreground="#0D0F12"
                                        BorderBrush="#7CFF6B"
                                        FontWeight="SemiBold"
                                        Visibility="Collapsed"/>

                            </StackPanel>

                            <TextBlock x:Name="SettingsUpdateStatusText"
                                       Text="GameWatch will check automatically when the dashboard starts."
                                       Foreground="#8B94A5"
                                       FontSize="12"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                    <!-- DATA AND LOGS -->
                    <Border Background="#15191F"
                            BorderBrush="#252A31"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="20"
                            Margin="0,0,0,18">

                        <StackPanel>

                            <TextBlock Text="GameWatch Data"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Text="DATABASE"
                                       Foreground="#7C8597"
                                       FontSize="11"
                                       Margin="0,18,0,4"/>

                            <TextBlock x:Name="SettingsDatabasePathText"
                                       Text=""
                                       Foreground="#D3D7DE"
                                       TextWrapping="Wrap"/>

                            <Button x:Name="SettingsOpenDatabaseFolderButton"
                                    Content="Open Database Folder"
                                    Width="190"
                                    Height="38"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0"
                                    Background="#1D2621"
                                    Foreground="#7CFF6B"
                                    BorderBrush="#2F3B32"/>

                            <TextBlock Text="LIVE SESSION FILE"
                                       Foreground="#7C8597"
                                       FontSize="11"
                                       Margin="0,20,0,4"/>

                            <TextBlock x:Name="SettingsActiveSessionPathText"
                                       Text=""
                                       Foreground="#D3D7DE"
                                       TextWrapping="Wrap"/>

                            <Button x:Name="SettingsOpenLogsButton"
                                    Content="Open Logs"
                                    Width="190"
                                    Height="38"
                                    HorizontalAlignment="Left"
                                    Margin="0,16,0,0"
                                    Background="#1D2621"
                                    Foreground="#7CFF6B"
                                    BorderBrush="#2F3B32"/>

                            <TextBlock x:Name="SettingsStatusText"
                                       Text=""
                                       Foreground="#8B94A5"
                                       FontSize="12"
                                       Margin="0,14,0,0"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                    <!-- ABOUT -->
                    <Border Background="#15191F"
                            BorderBrush="#252A31"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="About"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Text="GameWatch"
                                       Foreground="#7CFF6B"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,14,0,0"/>

                            <TextBlock Text="Windows game activity tracking service and dashboard."
                                       Foreground="#8B94A5"
                                       Margin="0,5,0,0"/>

                            <TextBlock x:Name="SettingsAboutVersionText"
                                       Text="Dashboard Version 1.0.0"
                                       Foreground="#D3D7DE"
                                       Margin="0,14,0,0"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>